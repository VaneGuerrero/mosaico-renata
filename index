<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mosaico Renata</title>
<style>
:root{--ink:#073f49;--teal:#04323b;--gold:#eb9c0c;--green:#0a8a24;--maroon:#7c0b24;--bg:#eef3ef;--card:#fff}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{padding:18px 24px 8px;display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px}
h1{margin:0;font-size:22px}
.hint{margin:0;color:#4c6a70;font-size:14px;flex-basis:100%}
.bar{display:flex;flex-wrap:wrap;gap:10px;padding:8px 24px 14px}
button,label.btn{font:inherit;font-weight:700;font-size:15px;border:0;border-radius:12px;padding:11px 16px;cursor:pointer;background:#fff;color:var(--ink);box-shadow:0 1px 0 rgba(0,0,0,.06),0 0 0 1px rgba(4,50,59,.18) inset}
.pri{background:var(--green);color:#fff;box-shadow:none}
.gold{background:var(--gold);color:var(--teal);box-shadow:none}
button:disabled{opacity:.45;cursor:default}
#count{align-self:center;font-weight:700}
.wrap{padding:0 24px 24px}
#drop{position:relative;border-radius:14px;overflow:hidden;box-shadow:0 10px 30px rgba(4,50,59,.15);background:#fff}
#drop.over{outline:4px dashed var(--green);outline-offset:4px}
canvas{display:block;width:100%;height:auto;cursor:pointer}
#tip{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);background:var(--teal);color:#fff;padding:10px 16px;border-radius:12px;font-size:14px;opacity:0;transition:opacity .2s;pointer-events:none}
input[type=file]{display:none}
</style></head><body>
<header><h1>Mosaico de fotos · Renata</h1>
<p class="hint">Elige o arrastra hasta 40 fotos. Se colocan en orden. Toca una casilla para cambiar esa foto; Mayús + clic para quitarla. Las fotos de 1080×1920 (9:16) entran completas, sin recortes ni deformación. Funciona sin internet: las fotos no salen de este equipo.</p></header>
<div class="bar">
  <label class="btn pri" for="files">＋ Añadir fotos</label><input id="files" type="file" accept="image/*" multiple>
  <button id="shuffle">Mezclar</button>
  <button id="clear">Vaciar</button>
  <button id="dl" class="gold">Descargar para la pantalla (1536×1024)</button>
  <button id="dlhd" class="gold">Descargar en alta (4608×3072)</button>
  <span id="count">0 / 40</span>
</div>
<div class="wrap"><div id="drop"><canvas id="cv" width="1536" height="1024"></canvas></div></div>
<input id="one" type="file" accept="image/*">
<div id="tip"></div>
<script>
const BG = "data:image/png;base64,";               // fondo con logos y casillas vacías, dibujado a 4608×3072 (3×)
const SLOTS = [[129,145,108,192],[259,145,108,192],[389,145,108,192],[519,145,108,192],[649,145,108,192],[779,145,108,192],[909,145,108,192],[1039,145,108,192],[1169,145,108,192],[1299,145,108,192],[129,359,108,192],[259,359,108,192],[389,359,108,192],[519,359,108,192],[649,359,108,192],[779,359,108,192],[909,359,108,192],[1039,359,108,192],[1169,359,108,192],[1299,359,108,192],[129,573,108,192],[259,573,108,192],[389,573,108,192],[519,573,108,192],[649,573,108,192],[779,573,108,192],[909,573,108,192],[1039,573,108,192],[1169,573,108,192],[1299,573,108,192],[129,787,108,192],[259,787,108,192],[389,787,108,192],[519,787,108,192],[649,787,108,192],[779,787,108,192],[909,787,108,192],[1039,787,108,192],[1169,787,108,192],[1299,787,108,192]];          // [x, y, ancho, alto] del hueco de cada foto, en 1536×1024 (108×192 = 9:16)
const cv = document.getElementById("cv"), g = cv.getContext("2d");
const bg = new Image(); bg.onload = draw; bg.src = BG;
let photos = new Array(40).fill(null);   // ImageBitmap | HTMLImageElement
let target = -1;
function tip(t) { const e = document.getElementById("tip"); e.textContent = t; e.style.opacity = 1; clearTimeout(tip.t); tip.t = setTimeout(() => e.style.opacity = 0, 2200); }
/* Reducción de alta calidad: se reduce a la mitad tantas veces como haga falta y luego al tamaño final.
   Así los textos finos del marco («La Felicidad Incluye») quedan nítidos, sin dientes ni manchas. */
function hq(img, sx, sy, sw, sh, dw, dh) {
  let c = document.createElement("canvas"), w = Math.round(sw), h = Math.round(sh);
  c.width = w; c.height = h; c.getContext("2d").drawImage(img, sx, sy, sw, sh, 0, 0, w, h);
  while (w / 2 >= dw && h / 2 >= dh) {
    const n = document.createElement("canvas"); n.width = Math.max(1, Math.round(w / 2)); n.height = Math.max(1, Math.round(h / 2));
    const x = n.getContext("2d"); x.imageSmoothingEnabled = true; x.imageSmoothingQuality = "high"; x.drawImage(c, 0, 0, n.width, n.height);
    c = n; w = n.width; h = n.height;
  }
  return c;
}
function crop(im, iw, ih) {                // 9:16 → la foto completa; otro formato → recorte centrado mínimo (nunca se estira)
  const a = im.naturalWidth / im.naturalHeight, b = iw / ih;
  if (Math.abs(a - b) / b < 0.01) return [0, 0, im.naturalWidth, im.naturalHeight];
  if (a > b) { const sw = im.naturalHeight * b; return [(im.naturalWidth - sw) / 2, 0, sw, im.naturalHeight]; }
  const sh = im.naturalWidth / b; return [0, (im.naturalHeight - sh) / 2, im.naturalWidth, sh];
}
const cache = new Map();                   // foto → versión reducida para cada escala
function render(ctx, k) {                  // k = 1 (1536×1024) o 3 (4608×3072)
  ctx.save(); ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = "high";
  ctx.clearRect(0, 0, 1536 * k, 1024 * k);
  if (bg.complete) ctx.drawImage(bg, 0, 0, 1536 * k, 1024 * k);
  SLOTS.forEach(([x, y, w, h], i) => {
    const im = photos[i], dx = Math.round(x * k), dy = Math.round(y * k), dw = Math.round(w * k), dh = Math.round(h * k);
    if (!im) { const gr = ctx.createLinearGradient(dx, dy, dx + dw, dy + dh); gr.addColorStop(0, "#e9f1ec"); gr.addColorStop(1, "#dbe7e0"); ctx.fillStyle = gr; ctx.fillRect(dx, dy, dw, dh); return; }
    const key = k + "|" + i; let r = cache.get(im); if (!r) { r = {}; cache.set(im, r); }
    if (!r[k]) { const [sx, sy, sw, sh] = crop(im, w, h); r[k] = hq(im, sx, sy, sw, sh, dw, dh); }
    ctx.drawImage(r[k], dx, dy, dw, dh);
  });
  ctx.restore();
}
function draw() {
  render(g, 1);
  document.getElementById("count").textContent = photos.filter(Boolean).length + " / 40";
}
function load(file) {
  return new Promise(res => { const u = URL.createObjectURL(file), im = new Image(); im.onload = () => res(im); im.onerror = () => { tip("No se pudo abrir " + file.name); res(null); }; im.src = u; });
}
async function addFiles(list) {
  const files = [...list].filter(f => f.type.startsWith("image/"));
  let free = photos.map((p, i) => p ? -1 : i).filter(i => i >= 0);
  if (files.length > free.length) tip("Solo caben " + free.length + " fotos más; se usan las primeras.");
  for (const f of files.slice(0, free.length)) { const im = await load(f); if (im) { photos[free.shift()] = im; draw(); } }
}
document.getElementById("files").onchange = e => { addFiles(e.target.files); e.target.value = ""; };
document.getElementById("one").onchange = async e => { const f = e.target.files[0]; e.target.value = ""; if (f && target >= 0) { const im = await load(f); if (im) { photos[target] = im; draw(); } } };
document.getElementById("shuffle").onclick = () => { const a = photos.filter(Boolean); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } photos = a.concat(new Array(40 - a.length).fill(null)); draw(); };
document.getElementById("clear").onclick = () => { if (photos.some(Boolean) && !confirmClear()) return; photos = new Array(40).fill(null); draw(); };
function confirmClear() { const b = document.getElementById("clear"); if (b.dataset.sure) { delete b.dataset.sure; b.textContent = "Vaciar"; return true; } b.dataset.sure = 1; b.textContent = "¿Seguro? Pulsa otra vez"; setTimeout(() => { delete b.dataset.sure; b.textContent = "Vaciar"; }, 3000); return false; }
cv.onclick = e => {
  const r = cv.getBoundingClientRect(), x = (e.clientX - r.left) * 1536 / r.width, y = (e.clientY - r.top) * 1024 / r.height;
  const i = SLOTS.findIndex(([sx, sy, w, h]) => x >= sx && x <= sx + w && y >= sy && y <= sy + h);
  if (i < 0) return;
  if (e.shiftKey && photos[i]) { photos[i] = null; draw(); tip("Foto " + (i + 1) + " quitada"); return; }
  target = i; document.getElementById("one").click();
};
const drop = document.getElementById("drop");
["dragenter", "dragover"].forEach(t => drop.addEventListener(t, e => { e.preventDefault(); drop.classList.add("over"); }));
["dragleave", "drop"].forEach(t => drop.addEventListener(t, e => { e.preventDefault(); drop.classList.remove("over"); }));
drop.addEventListener("drop", e => addFiles(e.dataTransfer.files));
function download(k) {
  let c = cv;
  if (k !== 1) { c = document.createElement("canvas"); c.width = 1536 * k; c.height = 1024 * k; render(c.getContext("2d"), k); }
  c.toBlob(b => { const a = document.createElement("a"); const d = new Date(), p = n => String(n).padStart(2, "0");
    a.href = URL.createObjectURL(b); a.download = `mosaico-renata-${k === 1 ? "pantalla" : "alta"}-${p(d.getHours())}${p(d.getMinutes())}.png`; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 30000); }, "image/png");
}
document.getElementById("dl").onclick = () => download(1);
document.getElementById("dlhd").onclick = () => { tip("Preparando la versión en alta…"); setTimeout(() => download(3), 30); };
</script></body></html>
